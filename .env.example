LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=woice-ai-agent

GOOGLE_API_KEY=
SPEECHMATICS_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
SERPAPI_API_KEY=


# Woice AI waitlist handoff. On the EC2 host with Redis bound locally:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
LEAD_TTL_SECONDS=86400
# Per-number caller record TTL. As the agent learns each detail it upserts a
# background checkpoint to this record (keyed by phone), so a dropped call, a
# rate-limited LLM, or a crash still leaves a resumable lead. 30 days by default.
CALLER_MEMORY_TTL_SECONDS=2592000
WOICE_WAITLIST_URL=https://woice.vercel.app
WOICE_REPLY_TO=
COMPANY_NAME=Woice AI
COMPANY_WEBSITE=https://woice.vercel.app

# SMTP is used only after the caller confirms the recap email. Gmail app
# credentials are the default path; SMTP_* remains available for another SMTP host.
GOOGLE_APP_EMAIL=
GOOGLE_APP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

USE_EL=false

# Sarvam is the default TTS path. Set USE_EL=true to use ElevenLabs English TTS.
ELEVENLABS_API_KEY=
ELEVEN_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Deepgram Nova-3 multilingual STT. "multi" auto-detects each segment so Hindi,
# English, and code-switching all work in the same call. Pin to "hi" or "en" only
# for intentionally single-language deployments.
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=25
DEEPGRAM_FILLER_WORDS=true
DEEPGRAM_SMART_FORMAT=false
GEMINI_LLM_MODEL=gemini-2.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=220
GEMINI_FALLBACK_ENABLED=true
GEMINI_FALLBACK_LLM_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MAX_RETRY_PER_LLM=0
GEMINI_TEMPERATURE=0.35

# LLM provider switch: "google" (Gemini), "groq" (Groq), or "aws" (Amazon Bedrock).
LLM_PROVIDER=google

# Route Gemini through Vertex AI instead of the Gemini API (still LLM_PROVIDER=google).
# Vertex AI uses Application Default Credentials (gcloud auth application-default
# login, a GOOGLE_APPLICATION_CREDENTIALS service-account key, or workload identity)
# — no GOOGLE_API_KEY is needed or sent. Set the project (or let ADC infer it) and
# the region. This is standard Vertex AI, not API-key "Express Mode".
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Groq settings (used when LLM_PROVIDER=groq). Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.35
GROQ_MAX_OUTPUT_TOKENS=220

# Bedrock settings (used only when LLM_PROVIDER=aws). Amazon Nova models are the
# most broadly accessible. Lowest latency/cost: amazon.nova-micro-v1:0. For Claude
# (and latency-optimized inference) use a regional inference profile such as
# us.anthropic.claude-3-5-haiku-20241022-v1:0 in us-east-2, and enable model
# access first. Set BEDROCK_LATENCY_OPTIMIZED=true only for models that support it.
AWS_BEDROCK_LLM_MODEL=amazon.nova-lite-v1:0
AWS_BEDROCK_REGION=us-east-1
BEDROCK_LATENCY_OPTIMIZED=false
BEDROCK_TEMPERATURE=0.35
BEDROCK_MAX_OUTPUT_TOKENS=220
# Bedrock long-term API key (bearer token, starts with ABSK...). Not an IAM key.
# Requires bedrock:InvokeModelWithResponseStream permission to invoke models.
AWS_BEARER_TOKEN_BEDROCK=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TARGET_LANGUAGE_CODE=hi-IN
SARVAM_SPEAKER=shubh
SARVAM_PACE=1.0
SARVAM_TEMPERATURE=0.6
SARVAM_OUTPUT_AUDIO_BITRATE=128k
SARVAM_MIN_BUFFER_SIZE=40
SARVAM_MAX_CHUNK_LENGTH=120
SARVAM_SPEECH_SAMPLE_RATE=22050

# ElevenLabs (used when USE_EL=true). auto_mode stays on so the plugin streams a
# sentence/phrase at a time with no manual chunk schedule. The multilingual flash
# model auto-detects from text by default; pin ELEVENLABS_TTS_LANGUAGE only for
# intentionally single-language deployments.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_LANGUAGE=auto
ELEVENLABS_INACTIVITY_TIMEOUT=180
ELEVENLABS_TEXT_NORMALIZATION=auto
ELEVENLABS_SYNC_ALIGNMENT=true

MIN_ENDPOINTING_DELAY=0.35
MAX_ENDPOINTING_DELAY=1.2
ENDPOINTING_MODE=dynamic
ENDPOINTING_ALPHA=0.65
MIN_INTERRUPTION_DURATION=0.5
# Intelligent barge-in: agent keeps talking through up to 5 words of backchannel
# and only yields on the 6th word. Lower toward 2-3 for snappier interruptions.
MIN_INTERRUPTION_WORDS=6
INTERRUPTIONS_ENABLED=true
# On LiveKit Cloud, adaptive barge-in is the premium default. Use vad locally to
# avoid Cloud adaptive-interruption auth errors.
INTERRUPTION_MODE=vad
FALSE_INTERRUPTION_TIMEOUT=2.0
PREEMPTIVE_GENERATION=true
PREEMPTIVE_TTS=false
PREEMPTIVE_MAX_SPEECH_DURATION=2.5
PREEMPTIVE_MAX_RETRIES=1
USE_TTS_ALIGNED_TRANSCRIPT=false

# Silero VAD tuning. These are faster than library defaults while still keeping
# enough padding for soft starts and phone audio.
VAD_MIN_SPEECH_DURATION=0.04
VAD_MIN_SILENCE_DURATION=0.42
VAD_PREFIX_PADDING_DURATION=0.45
VAD_MAX_BUFFERED_SPEECH=45.0
VAD_ACTIVATION_THRESHOLD=0.52
VAD_SAMPLE_RATE=16000
VAD_FORCE_CPU=true

# Input noise cancellation (ai-coustics) cleans audio BEFORE STT, so background
# noise/voices stop being transcribed. It needs either LiveKit Cloud OR a direct
# ai-coustics license key. Auto-on for *.livekit.cloud URLs and whenever
# AICOUSTICS_LICENSE_KEY is set; off otherwise (raw audio to STT).
# ENABLE_NOISE_CANCELLATION=true
# Get a license key from https://ai-coustics.com to run NC on self-hosted/localhost.
AICOUSTICS_LICENSE_KEY=
NOISE_CANCELLATION_MODEL=QUAIL_VF_L
AEC_WARMUP_DURATION=0.2
BACKGROUND_AUDIO_ENABLED=true
BACKGROUND_AMBIENT_CLIP=OFFICE_AMBIENCE
BACKGROUND_AMBIENT_VOLUME=0.18
BACKGROUND_THINKING_SOUND_ENABLED=true
BACKGROUND_THINKING_VOLUME=0.16
BACKGROUND_THINKING_VOLUME_ALT=0.12
BACKGROUND_AUDIO_STREAM_TIMEOUT_MS=200

# Logging / observability. Use warn in production for lowest log overhead.
LOG_LEVEL=warn
DEBUG_MODE=false
# Per-turn billing logs run cost math on every usage event; keep off for speed.
COST_LOGGING_ENABLED=false
